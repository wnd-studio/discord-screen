# Copie este arquivo para .production.vars antes do primeiro deploy.
# .production.vars é ignorado pelo Git e nunca deve ser enviado ao repositório.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
SESSION_SECRET=
PUBLIC_ORIGIN=https://discord-screen.SEUSUBDOMINIO.workers.dev

# Link público aberto pelo botão "Apoiar o projeto". Pode ser Pix, campanha ou site.
SUPPORT_URL=https://github.com/wnd-studio/discord-screen

# Opcionais: proprietário/equipe são detectados automaticamente.
ADMIN_DISCORD_IDS=
DISCORD_PUBLIC_KEY=

